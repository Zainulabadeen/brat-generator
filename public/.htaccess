RewriteEngine On

# Force HTTPS and the preferred non-www hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.bratgeneratorpro\.net$ [NC]
RewriteRule ^ https://bratgeneratorpro.net%{REQUEST_URI} [R=301,L]

# Preserve likely legacy/alternate URLs during the WordPress-to-Next.js migration.
# Exact Search Console/WordPress URLs should be added here if the backup or GSC later reveals more.
RewriteRule ^how-to/?$ /how-to-use/ [R=301,L]
RewriteRule ^styles/?$ /brat-styles/ [R=301,L]
RewriteRule ^key-features/?$ /features/ [R=301,L]
RewriteRule ^brat-generator-features/?$ /features/ [R=301,L]
RewriteRule ^how-to-make-a-brat-album-cover/?$ /blog/how-to-make-a-brat-album-cover-free/ [R=301,L]
RewriteRule ^blog/how-to-make-a-brat-album-cover/?$ /blog/how-to-make-a-brat-album-cover-free/ [R=301,L]

# Serve the Next.js static export cleanly on Apache/cPanel.
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Prevent directory browsing if the host allows this directive.
Options -Indexes

# Compress text assets when Apache mod_deflate is available.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Safe baseline response headers. CSP is intentionally not locked yet so future analytics can be added without breaking the site.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(?:css|js|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Browser caching for static assets when mod_expires is available.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
