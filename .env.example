# Optional: add these values before the FINAL production build.
# Do not put quotes around values.

# Google Analytics 4 (example format: G-ABC123DE45)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token (optional).
# For the recommended Domain Property DNS verification, leave this blank.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta verification token (optional if you verify by DNS/import from GSC).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
